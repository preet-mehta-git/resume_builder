# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resume_builder?retryWrites=true&w=majority

# JWT Secret Key for user authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Google Gemini API Key for AI Resume Analysis and Scoring
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Port for local Node development
PORT=8080
